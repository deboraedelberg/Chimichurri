# Neon PostgreSQL — create a project at https://neon.tech and copy the connection string
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/chimichurri?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="replace-me-with-openssl-rand-hex-32"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxx"

# Vercel Blob — https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
